# =============================================================================
# Пример переменных окружения.
#
# Как использовать:
# Скопируйте этот файл в `.env`:
#         cp .env.example .env
# =============================================================================


# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------

# Обязательно. Секретный ключ Django.
# Сгенерировать можно так:
#     python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# или:
#     openssl rand -base64 50
SECRET_KEY=change-me-to-a-long-random-50-char-string

# Режим отладки. Для продакшена и проверки хакатона оставьте 0.
# 1 = DEBUG включён, 0 = выключен.
DJANGO_DEBUG=0

# Список разрешённых хостов, через запятую. Для локальной проверки можно "*".
# В проде перечислите конкретные домены.
ALLOWED_HOSTS=*

# Путь к файлу базы SQLite. По умолчанию в docker-compose монтируется ./data.
DB_PATH=/app/data/db.sqlite3


# -----------------------------------------------------------------------------
# MAX (мессенджер)
# -----------------------------------------------------------------------------

# Обязательно. Токен бота MAX, выданный организаторами хакатона.
# Формат: строка без пробелов.
# Где взять: личный кабинет платформы MAX / выдан организаторами.
# НЕ КОММИТЬ реальный токен в репозиторий.
MAX_BOT_TOKEN=your-max-bot-token-here

# Базовый URL API MAX.
# Обычно: https://platform-api2.max.ru
MAX_API_BASE_URL=https://platform-api2.max.ru


# -----------------------------------------------------------------------------
# CloudPub (публикация dev-сервера во внешнюю сеть)
# -----------------------------------------------------------------------------

# Токен CloudPub. Нужен, если используете сервис cloudpub из docker-compose
# для публикации локального веб-сервера по HTTPS (удобно для тестирования
# мини-приложения MAX, которому нужен защищённый HTTPS-адрес).
#
# Если не публикуете через cloudpub — можно оставить пустым или удалить
# сервис cloudpub из docker-compose.yml.
CLOUDPUB_TOKEN=your-cloudpub-token-here


# -----------------------------------------------------------------------------
# CORS / CSRF (для мини-приложения MAX и веб-фронта)
# -----------------------------------------------------------------------------

# Список origin'ов, с которых разрешены cross-origin запросы, через запятую.
CORS_ALLOWED_ORIGINS=https://max-front-pearl.vercel.app,https://platform-api2.max.ru

# Список доверенных origin'ов для CSRF, через запятую.
# Здесь можно использовать wildcard-поддомены.
CSRF_TRUSTED_ORIGINS=https://platform-api2.max.ru,https://*.cloudpub.ru,https://*.trycloudflare.com